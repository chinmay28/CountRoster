node_modules/
dist/
*.log
.DS_Store

# Server runtime data (the SQLite file is the live database, not source)
data/
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Go server build artifacts; webdist/ receives the built PWA before `go build`
# embeds it (only its README placeholder is source)
server/bin/
server/cmd/countroster/webdist/*
!server/cmd/countroster/webdist/README.txt
# …and the engine's, from the `--mode native` web build (scripts/build-android.sh)
server/cmd/engine/webdist/*
!server/cmd/engine/webdist/README.txt

# Capacitor / iOS (the ios/ project is committed; these generated parts are not)
apps/web/ios/App/Pods/
apps/web/ios/App/App/public/
apps/web/ios/App/build/
apps/web/ios/DerivedData/
*.xcuserstate

# Android: the Go engine binaries and the native web bundle are build outputs
# (scripts/build-android.sh), as are Gradle's
apps/web/dist-native/
apps/android/app/src/main/jniLibs/
apps/android/.gradle/
apps/android/build/
apps/android/app/build/
apps/android/local.properties
*.keystore
